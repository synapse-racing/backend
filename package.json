{
  "name": "synapse-backend",
  "version": "0.0.1",
  "description": "Synapse Racing backend workspace: monolithic API plus separately deployable services.",
  "author": "",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "license": "UNLICENSED",
  "scripts": {
    "build": "pnpm -r build",
    "build:libs": "pnpm --filter \"./libs/**\" run build",
    "build:api": "pnpm --filter @synapse/api build",
    "build:core-api": "pnpm --filter @synapse/core-api build",
    "build:multiplayer": "pnpm --filter @synapse/multiplayer build",
    "start": "node apps/api/dist/main.js",
    "start:core-api": "node apps/core-api/dist/main.js",
    "start:multiplayer": "node apps/multiplayer/dist/main.js",
    "dev:api": "pnpm --filter @synapse/api dev",
    "dev:core-api": "pnpm --filter @synapse/core-api dev",
    "dev:multiplayer": "pnpm --filter @synapse/multiplayer dev",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"test/**/*.ts\"",
    "lint": "pnpm build:libs && eslint \"{apps,libs,test}/**/*.ts\"",
    "lint:fix": "pnpm lint --fix",
    "prisma:generate": "prisma generate",
    "db:deploy": "prisma db push",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test": "pnpm build:libs && pnpm -r run test",
    "test:e2e": "node test/run-e2e.cjs"
  },
  "dependencies": {
    "ioredis": "^5.6.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.2.1",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/testing": "^11.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.2.1",
    "@prisma/client": "6.14.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "jest": "^30.0.0",
    "mongodb-memory-server": "^10.4.3",
    "prettier": "^3.4.2",
    "prisma": "6.14.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "tsc-watch": "^7.1.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "source-map-support": "^0.5.21"
  },
  "jest": {
    "testEnvironment": "node",
    "moduleFileExtensions": ["ts", "js", "json"]
  }
}

