# Synapse Racing — configuration template
#
# One file for every environment:
# - Local development: copy to .env (pnpm install && pnpm dev:api).
# - Docker Compose production: use as-is with
#   docker compose --env-file .env -f compose.prod.yaml up -d --build --wait
# - Pterodactyl: upload this file as /home/container/.env.
#
# Never commit your real .env; secrets belong only on the servers.

# --- Core -------------------------------------------------------------------
# Local runs use development; Docker and Pterodactyl set production themselves.
NODE_ENV=development
# true allows exploring /api/docs locally; production keeps it false here and
# enables it explicitly only when you decide to.
SWAGGER_ENABLED=false
PORT=3000
# CORS origin for local/standalone runs. Compose prod/dist overrides it with
# PUBLIC_APP_URL below, but this variable is still required and validated.
FRONTEND_URL=http://localhost:5173

# --- Database ---------------------------------------------------------------
# MongoDB with a replica set (required for multi-document transactions).
DATABASE_URL=mongodb://127.0.0.1:27017/synapse?replicaSet=rs0&directConnection=true

# --- Session secrets (replace both, and make them different) -----------------
JWT_ACCESS_SECRET=replace-with-an-access-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-refresh-secret-of-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# --- Docker Compose production ----------------------------------------------
# Public origin of the frontend, published by compose.prod.yaml and used as
# the API's CORS origin instead of FRONTEND_URL.
PUBLIC_APP_URL=https://racing.example.com
# Host port published by the frontend container in compose.prod.yaml.
APP_PORT=80

# --- Event bus (optional) ----------------------------------------------------
# Required by compose.dist.yaml (redis://redis:6379) to sync core-api and
# multiplayer across processes. Leave commented for the monolith.
# REDIS_URL=redis://127.0.0.1:6379
