NODE_ENV=development
SWAGGER_ENABLED=true
PORT=3000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=mongodb://127.0.0.1:27017/synapse?replicaSet=rs0&directConnection=true
JWT_ACCESS_SECRET=replace-with-an-access-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-refresh-secret-of-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
# Optional Redis event bus. When set, core-api and multiplayer share events
# (for example logging out removes that player's cars from any room).
# Leave empty to run as a single monolith with in-memory events only.
# REDIS_URL=redis://127.0.0.1:6379
